#!/bin/sh
set -eu

if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  exec codex --version
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

find_compatible_python() {
  for candidate in \
    "${PASEO_CODEX_PROFILE_PYTHON:-}" \
    python3 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    "${HOME:-}/.pyenv/shims/python3"
  do
    [ -n "$candidate" ] || continue
    resolved=$(command -v "$candidate" 2>/dev/null || :)
    [ -n "$resolved" ] || continue
    if "$resolved" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  return 1
}

python_bin=$(find_compatible_python) || {
  echo "codex-profile: Python 3.11 or newer is required" >&2
  exit 1
}

exec "$python_bin" "$script_dir/codex-profile.py" "$@"
